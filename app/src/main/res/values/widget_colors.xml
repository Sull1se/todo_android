    <color name="widget_secondary_text">#FF444746</color>
    <color name="widget_check_outline">#FF747775</color>
    <color name="widget_checked">#FF0B57D0</color>
    <color name="widget_add_background">#FFD3E3FD</color>
    <color name="widget_add_icon">#FF041E49</color>
    <color name="widget_flag">#FFE53935</color>
</resources>
