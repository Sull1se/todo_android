<?xml version="1.0" encoding="utf-8"?>
<!-- 卡片待办行的正文区（两种勾选控件共用）：点击在桌面弹出编辑窗口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_body"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/widget_row_bar"
        android:layout_width="3dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_row_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_secondary_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_row_flag"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/widget_flagged"
        android:src="@drawable/ic_widget_flag"
        android:tint="@color/widget_flag"
        android:visibility="gone" />
</LinearLayout>
